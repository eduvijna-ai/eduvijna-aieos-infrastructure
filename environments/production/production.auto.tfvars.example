# EXAMPLE ONLY — copy to production.auto.tfvars locally; never commit real values.
# production.auto.tfvars is gitignored.

do_project_id = "REPLACE_WITH_EXISTING_AIEOS_PROJECT_ID"

# Candidate CIDR only — collision proof required before apply.
vpc_ip_range = "10.130.0.0/20"

# HARD GUARD — remain false until Chief Architect authorizes production apply.
enable_cloud_resources = false

# Independent Temporal Cloud guard — remain false until a later Chief Architect
# Temporal Cloud production provisioning gate. Independent from DigitalOcean.
enable_temporal_cloud_resources = false

# Required Temporal Cloud inputs (no production defaults). Unresolved decisions —
# replace only under a later authorized gate. Never commit live account IDs,
# Namespace names, regions, or retention as frozen source constants.
temporal_cloud_allowed_account_id  = "REPLACE_WITH_TEMPORAL_CLOUD_ACCOUNT_ID"
temporal_namespace_name            = "replace-with-namespace-name"
temporal_namespace_region          = "REPLACE_WITH_TEMPORAL_CLOUD_REGION"
temporal_namespace_retention_days  = 1
