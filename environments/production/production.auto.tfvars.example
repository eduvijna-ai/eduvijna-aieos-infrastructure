# EXAMPLE ONLY — copy to production.auto.tfvars locally; never commit real values.
# production.auto.tfvars is gitignored.

do_project_id = "REPLACE_WITH_EXISTING_AIEOS_PROJECT_ID"

# Frozen production VPC contract from ADR-AIEOS-048.
production_vpc_name     = "aieos-prod-blr1"
production_vpc_region   = "blr1"
production_vpc_ip_range = "10.130.0.0/20"

# Independent production slice guards — remain false until explicitly authorized.
enable_production_vpc          = false
enable_aistor_resources        = false
enable_workflow_dispatcher_app = false
enable_temporal_worker_app     = false

# Common immutable OCI digest for both workload apps.
# Leave null until a later governed OCI publication / deployment gate provides
# an exact authorized digest.
aieos_backend_image_digest = null

# Independent Temporal Cloud guard — remain false until a later Chief Architect
# Temporal Cloud production provisioning gate. Independent from all DigitalOcean
# production slices.
enable_temporal_cloud_resources = false

# Temporal inputs remain commented while the guard is false.
# Uncomment and set ONLY under an authorized Temporal Cloud provisioning gate.
# Copying this example unchanged must yield zero Temporal provider instances.
#
# temporal_cloud_allowed_account_id = "SET_ONLY_UNDER_AUTHORIZED_TEMPORAL_GATE"
# temporal_namespace_name           = "SET_ONLY_UNDER_AUTHORIZED_TEMPORAL_GATE"
# temporal_namespace_region           = "SET_ONLY_UNDER_AUTHORIZED_TEMPORAL_GATE"
# temporal_namespace_retention_days   = <SET_ONLY_UNDER_AUTHORIZED_TEMPORAL_GATE>
